# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Authentication / fixture configuration. Keep real values only in server/.env.
# Generate a unique CSRF secret, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_CSRF_SECRET="replace-with-a-local-random-secret"
# Comma-separated browser origins permitted to send mutations through the local proxy.
TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:4173"

# Fixture accounts are deliberately local-only. `npm run prisma:seed` refuses
# to add them until this is exactly `local`; it is always refused in production.
LAB3_SEED_MODE=local
# Optional override for the documented local fixture password. Do not commit a real password.
# LAB3_SEED_PASSWORD="Lab3-Demo-Only!2026"

# Set these only for a one-time local migrated-user provisioning command.
# Never commit the real password, and remove it from the environment afterward.
# LAB3_PROVISION_MODE=local
# LAB3_PROVISION_EMAIL="existing.user@example.test"
# LAB3_PROVISION_PASSWORD="replace-with-a-one-time-password"
